# ---------------------------------------------------------------------------
# Qalb Collections — environment variables
# Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# Database -------------------------------------------------------------------
# Local development uses SQLite (zero setup):
DATABASE_URL="file:./dev.db"
# For PostgreSQL, set `provider = "postgresql"` in prisma/schema.prisma and use:
# DATABASE_URL="postgresql://user:password@localhost:5432/qalbcollections?schema=public"

# Application ----------------------------------------------------------------
# Absolute origin, used for canonical URLs, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret used to sign session cookies. Generate with:
#   openssl rand -base64 48
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# Seeding --------------------------------------------------------------------
# Credentials for the initial SUPER_ADMIN created by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@qalbcollections.com"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_CUSTOMER_EMAIL="customer@example.com"
SEED_CUSTOMER_PASSWORD="ChangeMe!2026"

# Analytics ------------------------------------------------------------------
# Provider-agnostic. Leave blank to use the no-op console sink in development.
# Supported: "none" | "console" | "gtag" | "plausible"
NEXT_PUBLIC_ANALYTICS_PROVIDER="console"
NEXT_PUBLIC_ANALYTICS_ID=""

# Payments -------------------------------------------------------------------
# Comma-separated list of enabled payment providers, resolved by the payment
# registry in src/lib/payments. "cod" is always available as a fallback.
PAYMENT_PROVIDERS="cod,bank_transfer"
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
