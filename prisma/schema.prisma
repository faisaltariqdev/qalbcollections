// Qalb Collections — data model.
//
// Portability: status/role/type columns are plain `String` validated by Zod
// (see src/lib/constants.ts) rather than native DB enums, and JSON payloads are
// stored as `String`. This keeps a single schema working on SQLite locally and
// PostgreSQL in production — switching only requires changing `provider` below
// and re-running migrations.
//
// Money: every monetary column is an integer in the currency's minor unit
// (e.g. paisa for PKR, cents for USD). Never store money as a float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Taxonomy
// ---------------------------------------------------------------------------

model Category {
  id             String  @id @default(cuid())
  name           String
  slug           String  @unique
  description    String?
  editorialIntro String?
  imageUrl       String?
  parentId       String?
  sortOrder      Int     @default(0)
  status         String  @default("ACTIVE") // CategoryStatus
  featured       Boolean @default(false)

  seoTitle          String?
  seoDescription    String?
  canonicalUrl      String?
  ogImageUrl        String?
  socialTitle       String?
  socialDescription String?
  noIndex           Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent     Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Category[]            @relation("CategoryTree")
  products   Product[]
  attributes AttributeDefinition[]

  @@index([parentId])
  @@index([status])
}

/// Declares which specifications/filters exist for a category. This is what
/// makes the catalogue category-agnostic: watches declare Movement/Case Size,
/// perfumes declare Fragrance Family/Top Notes, and the frontend renders
/// whatever is declared without code changes.
model AttributeDefinition {
  id          String  @id @default(cuid())
  categoryId  String
  key         String
  label       String
  unit        String?
  type        String  @default("TEXT") // AttributeType
  group       String? // Specification table grouping, e.g. "Movement"
  filterable  Boolean @default(false)
  comparable  Boolean @default(false)
  showInSpecs Boolean @default(true)
  sortOrder   Int     @default(0)

  category Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  values   ProductAttribute[]

  @@unique([categoryId, key])
  @@index([categoryId])
}

model Collection {
  id             String  @id @default(cuid())
  name           String
  slug           String  @unique
  description    String?
  editorialIntro String?
  imageUrl       String?
  status         String  @default("ACTIVE") // CategoryStatus
  featured       Boolean @default(false)
  sortOrder      Int     @default(0)

  seoTitle          String?
  seoDescription    String?
  canonicalUrl      String?
  ogImageUrl        String?
  socialTitle       String?
  socialDescription String?
  noIndex           Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products ProductCollection[]
}

/// Cross-cutting labels used by the Gift Guide and Find Your Timepiece finder.
/// `kind` separates namespaces (occasion / style / audience) so new discovery
/// journeys are data entry, not new tables.
model Tag {
  id        String  @id @default(cuid())
  slug      String  @unique
  label     String
  kind      String // TagKind
  sortOrder Int     @default(0)
  imageUrl  String?

  products ProductTag[]

  @@index([kind])
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

model Product {
  id               String  @id @default(cuid())
  name             String
  slug             String  @unique
  sku              String  @unique
  brand            String
  shortDescription String?
  description      String?
  /// Editorial long-form copy shown as "The Story" on the product page.
  story            String?
  categoryId       String

  price          Int // minor units
  compareAtPrice Int?
  currency       String @default("PKR")

  stock             Int     @default(0)
  lowStockThreshold Int     @default(2)
  allowBackorder    Boolean @default(false)

  status      String  @default("DRAFT") // ProductStatus
  featured    Boolean @default(false)
  newArrival  Boolean @default(false)
  bestseller  Boolean @default(false)
  comingSoon  Boolean @default(false)
  limited     Boolean @default(false)
  exclusive   Boolean @default(false)
  sortOrder   Int     @default(0)
  publishedAt DateTime?

  seoTitle          String?
  seoDescription    String?
  canonicalUrl      String?
  ogImageUrl        String?
  socialTitle       String?
  socialDescription String?
  noIndex           Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category    Category           @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  variants    ProductVariant[]
  attributes  ProductAttribute[]
  collections ProductCollection[]
  tags        ProductTag[]
  reviews     Review[]
  faqs        Faq[]
  cartItems   CartItem[]
  wishlisted  WishlistItem[]
  orderItems  OrderItem[]

  @@index([categoryId])
  @@index([status])
  @@index([brand])
  @@index([featured])
  @@index([price])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String
  width     Int?
  height    Int?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  name      String // e.g. "Strap"
  value     String // e.g. "Black Calf Leather"
  sku       String  @unique
  price     Int?
  stock     Int     @default(0)
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductAttribute {
  id           String  @id @default(cuid())
  productId    String
  definitionId String
  value        String
  /// Populated for NUMBER attributes so range filters and sorting can use SQL.
  valueNumber  Float?

  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  definition AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([productId, definitionId])
  @@index([definitionId, value])
}

model ProductCollection {
  productId    String
  collectionId String
  sortOrder    Int    @default(0)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model Faq {
  id        String  @id @default(cuid())
  question  String
  answer    String
  sortOrder Int     @default(0)
  /// Null = a global FAQ shown on every product page and the FAQ page.
  productId String?

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Review {
  id         String  @id @default(cuid())
  productId  String
  customerId String?
  authorName String
  rating     Int
  title      String?
  body       String
  /// Reviews are hidden until a moderator approves them, and only approved
  /// reviews are ever emitted as structured data.
  approved   Boolean @default(false)

  createdAt DateTime @default(now())

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([productId, approved])
}

// ---------------------------------------------------------------------------
// People & sessions
// ---------------------------------------------------------------------------

model Customer {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  phone        String?
  passwordHash String?
  authProvider String  @default("credentials")
  active       Boolean @default(true)
  marketingOptIn Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  carts     Cart[]
  wishlists Wishlist[]
  reviews   Review[]
  sessions  Session[]
  addresses Address[]
}

model Address {
  id         String  @id @default(cuid())
  customerId String
  label      String?
  line1      String
  line2      String?
  city       String
  region     String?
  postalCode String?
  country    String  @default("PK")
  isDefault  Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("EDITOR") // AdminRole
  active       Boolean  @default(true)
  lastLoginAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions  Session[]
  auditLogs AuditLog[]
}

/// Opaque server-side sessions. Only a SHA-256 hash of the token is stored, so
/// a database leak cannot be replayed as a login, and sessions stay revocable.
model Session {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  customerId  String?
  adminUserId String?
  expiresAt   DateTime
  userAgent   String?
  createdAt   DateTime @default(now())

  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Commerce
// ---------------------------------------------------------------------------

model Cart {
  id         String  @id @default(cuid())
  /// Anonymous carts are keyed by a cookie token; they are claimed on login.
  token      String  @unique
  customerId String?
  currency   String  @default("PKR")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    CartItem[]

  @@index([customerId])
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int    @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
}

model Wishlist {
  id         String  @id @default(cuid())
  customerId String?
  token      String  @unique

  createdAt DateTime @default(now())

  customer Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
}

model Order {
  id          String  @id @default(cuid())
  orderNumber String  @unique
  /// Opaque token so a guest can see their own confirmation without an account,
  /// and nobody can enumerate orders by number.
  accessToken String?
  customerId  String?

  customerName  String
  customerEmail String
  customerPhone String

  status        String @default("PENDING") // OrderStatus
  paymentStatus String @default("UNPAID") // PaymentStatus
  /// Identifier of the payment provider that handled this order, resolved
  /// through the provider registry in src/lib/payments.
  paymentMethod String @default("cod")
  paymentRef    String?

  subtotal      Int
  shippingTotal Int    @default(0)
  discountTotal Int    @default(0)
  taxTotal      Int    @default(0)
  total         Int
  currency      String @default("PKR")

  couponCode String?
  notes      String?

  shippingName       String
  shippingLine1      String
  shippingLine2      String?
  shippingCity       String
  shippingRegion     String?
  shippingPostalCode String?
  shippingCountry    String  @default("PK")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  events   OrderEvent[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?

  /// Denormalised so historical orders survive product edits and deletions.
  name     String
  brand    String
  sku      String
  imageUrl String?
  variant  String?

  quantity  Int
  unitPrice Int
  lineTotal Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  type      String
  message   String
  actor     String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Coupon {
  id             String   @id @default(cuid())
  code           String   @unique
  description    String?
  /// PERCENT or FIXED
  type           String   @default("PERCENT")
  value          Int
  minSubtotal    Int      @default(0)
  maxRedemptions Int?
  redemptions    Int      @default(0)
  active         Boolean  @default(true)
  startsAt       DateTime?
  endsAt         DateTime?

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Content management
// ---------------------------------------------------------------------------

model Banner {
  id        String  @id @default(cuid())
  title     String
  eyebrow   String?
  subtitle  String?
  imageUrl  String
  imageAlt  String
  ctaLabel  String?
  ctaHref   String?
  ctaLabel2 String?
  ctaHref2  String?
  placement String  @default("home_hero")
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, active])
}

/// Lets an editor reorder, retitle, or switch off homepage sections without a
/// deploy. `key` maps to a React section component in the section registry.
model HomeSection {
  id        String  @id @default(cuid())
  key       String  @unique
  eyebrow   String?
  title     String?
  body      String?
  ctaLabel  String?
  ctaHref   String?
  imageUrl  String?
  sortOrder Int     @default(0)
  enabled   Boolean @default(true)

  updatedAt DateTime @updatedAt
}

model NavItem {
  id        String  @id @default(cuid())
  label     String
  href      String
  location  String  @default("header") // header | footer
  groupName String?
  badge     String?
  parentId  String?
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  parent   NavItem?  @relation("NavTree", fields: [parentId], references: [id], onDelete: Cascade)
  children NavItem[] @relation("NavTree")

  @@index([location, active])
}

model Announcement {
  id        String  @id @default(cuid())
  message   String
  href      String?
  active    Boolean @default(true)
  sortOrder Int     @default(0)
}

model Page {
  id      String @id @default(cuid())
  title   String
  slug    String @unique
  /// Markdown-lite body rendered by src/lib/markdown.ts.
  body    String
  status  String @default("ACTIVE")

  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  noIndex        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  body        String
  category    String    @default("Guides")
  coverImage  String?
  coverAlt    String?
  authorName  String    @default("Qalb Collections")
  readMinutes Int       @default(4)
  status      String    @default("DRAFT")
  featured    Boolean   @default(false)
  publishedAt DateTime?

  seoTitle          String?
  seoDescription    String?
  canonicalUrl      String?
  ogImageUrl        String?
  socialTitle       String?
  socialDescription String?
  noIndex           Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
}

model MediaAsset {
  id           String   @id @default(cuid())
  url          String   @unique
  filename     String
  alt          String   @default("")
  mimeType     String
  sizeBytes    Int      @default(0)
  width        Int?
  height       Int?
  folder       String   @default("products")
  uploadedBy   String?
  createdAt    DateTime @default(now())

  @@index([folder])
}

/// Single source of truth for contact details, socials, shipping copy and
/// feature flags, so nothing sensitive or changeable is hard-coded in views.
model SiteSetting {
  key       String   @id
  value     String
  group     String   @default("general")
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Signals & audit
// ---------------------------------------------------------------------------

model NotifyRequest {
  id        String   @id @default(cuid())
  email     String
  topic     String   @default("perfumes")
  createdAt DateTime @default(now())

  @@unique([email, topic])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("footer")
  createdAt DateTime @default(now())
}

/// Enquiries from the contact form. Kept so an admin can answer from one place
/// instead of relying on an inbox rule.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String   @default("General enquiry")
  message   String
  /// NEW | READ | ANSWERED | ARCHIVED
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

model SearchQuery {
  id        String   @id @default(cuid())
  term      String
  results   Int      @default(0)
  createdAt DateTime @default(now())

  @@index([term])
}

model AuditLog {
  id          String   @id @default(cuid())
  adminUserId String?
  actorEmail  String?
  action      String
  entity      String
  entityId    String?
  summary     String?
  createdAt   DateTime @default(now())

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}
